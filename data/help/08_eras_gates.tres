[resource]
script = ExtResource("1")
id = "eras_gates"
order = 8
title = "Eras and gates"
body = "The settlement grows through seven eras. To reach the next one you need enough citizens, enough gold and the landmark building of the era you are in.

{gates}

Reaching an era unlocks its buildings. A card tells you what is new and what gets harder. The Objectives panel (top left) shows what the next gate still needs.

The last landmark is the Skyheart. There is no era after Ascendant."
